{
  "name": "web-tools",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "description": "A collection of pure frontend web tools (monorepo root)",
  "scripts": {
    "dev": "pnpm --filter @web-tools/web dev",
    "dev:server": "pnpm --filter @web-tools/server dev",
    "build": "pnpm --filter @web-tools/web build",
    "preview": "pnpm --filter @web-tools/web preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "prepare": "husky",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "eslint": "^10.8.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "husky": "^9.1.7",
    "wrangler": "^4.124.0"
  }
}

# 复制为 apps/server/.env；服务端和 Drizzle 命令会自动读取
# 本地开发默认值见 src/env.ts；这里列出生产（Docker）常用覆盖项

# Postgres 连接串（调试时指向内网 dev 机器）
DATABASE_URL=postgres://webtools:webtools@localhost:5432/webtools

# HTTP 端口
PORT=8787

# 文件存储卷
DATA_DIR=/data/files

# 在反代之后部署时设 1（X-Forwarded-For 解析）
TRUST_PROXY=0

# 允许跨域携带凭证的前端源（CORS），逗号分隔
CORS_ORIGINS=https://webtools.pzehrel.com,http://localhost:1420

# 注册开关：默认关闭。要注册自己的账号时临时设 true，注册完关回
ALLOW_REGISTRATION=false
